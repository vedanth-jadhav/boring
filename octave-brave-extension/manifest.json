{
  "manifest_version": 3,
  "name": "Boring Notch Octave Bridge",
  "version": "1.2.0",
  "description": "Connects Octave music, lyrics and playback controls to Boring Notch.",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "https://music.octavestreaming.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.octavestreaming.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.octavestreaming.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "key": ""
}
