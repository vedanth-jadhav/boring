      "refersTo": "segmented-container",
      "description": "Small focus/settings choice group; selected segment shown.",
      "html": "<div class=\"ds-segmented\" role=\"group\" aria-label=\"Focus tool\"><button class=\"ds-segment ds-selected\" aria-pressed=\"true\">Timer</button><button class=\"ds-segment\" aria-pressed=\"false\">Stay awake</button></div>",
      "css": ".ds-segmented{display:inline-flex;background:#111;border-radius:19px;padding:3px;gap:3px}.ds-segment{font-family:Inter,\"Segoe UI\",sans-serif;cursor:pointer;border:0;background:none;color:#a4a4aa;font-size:11px;border-radius:16px;padding:6px 13px;transition:background-color 160ms ease-out,color 160ms ease-out,box-shadow 160ms ease-out,transform 130ms ease-out}.ds-segment.ds-selected{background:#1a2b41;color:#cee7ff;box-shadow:inset 0 1px 0 #96ccff21}.ds-segment:focus-visible{outline:2px solid var(--control-blue,#78bbff);outline-offset:3px}.ds-segment:active:not(:disabled){transform:scale(.965)}@media(prefers-reduced-motion:reduce){button:hover,button:active{transform:none!important}button{transition:none!important}}"
    },
    {
      "name": "Settings switch",
      "kind": "input",
      "refersTo": "settings-switch",
      "description": "Small native-feeling checkbox switch from settings rows.",
      "html": "<label class=\"ds-switch-label\">Glass surface<input class=\"ds-switch\" type=\"checkbox\" checked></label>",
      "css": ".ds-switch-label{display:flex;gap:12px;align-items:center;font-family:Inter,\"Segoe UI\",sans-serif;color:var(--ink,#f5f5f7);font-size:13px}.ds-switch{appearance:none;width:27px;height:16px;border-radius:10px;background:#3c3c41;position:relative;margin:0;cursor:pointer;transition:background .15s}.ds-switch:after{content:\"\";position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:#eee;transition:transform .15s}.ds-switch:checked{background:var(--control-blue,#78bbff)}.ds-switch:checked:after{transform:translateX(11px);background:#071014}.ds-switch:focus-visible{outline:2px solid var(--control-blue,#78bbff);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-switch,.ds-switch:after{transition:none!important}}"
    },
    {
      "name": "Transport button",
      "kind": "button",
      "refersTo": "transport",
      "description": "Neutral play glyph in the small music transport hit area.",
      "html": "<button class=\"ds-transport\" aria-label=\"Play\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m7 3 14 9-14 9Z\" fill=\"currentColor\" stroke=\"none\"/></svg></button>",
      "css": ".ds-transport{font-family:Inter,\"Segoe UI\",sans-serif;cursor:pointer;border:0;color:var(--ink,#f5f5f7);background:none;width:28px;height:27px;display:grid;place-items:center;border-radius:7px;transition:background-color 160ms ease-out,color 160ms ease-out,box-shadow 160ms ease-out,transform 130ms ease-out}.ds-transport svg{width:25px;height:25px}.ds-transport:hover:not(:disabled){background:#13263a;color:#d7eaff;box-shadow:inset 0 1px 0 #9bd0ff29,0 3px 8px #00000035;transform:scale(1.12)}.ds-transport:active:not(:disabled){transform:scale(.89)}.ds-transport:disabled{opacity:.34;cursor:default}.ds-transport:focus-visible{outline:2px solid var(--control-blue,#78bbff);outline-offset:3px}@media(prefers-reduced-motion:reduce){button:hover,button:active{transform:none!important}button{transition:none!important}}"
    },
    {
      "name": "Compact island",
      "kind": "custom",
      "refersTo": "island-compact",
      "description": "Closed silhouette with a short label; photographic cover intentionally omitted from this isolated specimen.",
      "html": "<div class=\"ds-compact\" tabindex=\"0\" role=\"button\" aria-label=\"Open island\"><span>Music &amp; lyrics</span><span class=\"ds-wave\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i></span></div>",
      "css": ".ds-compact{position:relative;display:flex;align-items:center;gap:12px;padding:0 12px 0 37px;width:204px;height:34px;border-radius:17px;background:#050505;color:var(--ink,#f5f5f7);font-family:Inter,\"Segoe UI\",sans-serif;font-size:10px;font-weight:500;filter:drop-shadow(0 12px 16px #00000024)}.ds-compact>span:first-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;flex:1}.ds-wave{display:flex;gap:2px;align-items:center;height:13px;width:18px}.ds-wave i{height:4px;width:2px;background:var(--accent,#70d8ef);border-radius:2px}.ds-wave i:nth-child(2){height:10px}.ds-wave i:nth-child(3){height:13px}.ds-wave i:nth-child(4){height:8px}.ds-compact:focus-visible{outline:2px solid var(--control-blue,#78bbff);outline-offset:3px}"
    },
    {
      "name": "Shelf drop area",
      "kind": "custom",
      "refersTo": "shelf-drop",
      "description": "Bounded dashed file drop target with source drag state.",
      "html": "<div class=\"ds-dropzone\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 6h7l2 3h9v11H3Z\"/></svg><div><strong>Drop files here</strong><p>Copies stay on your shelf</p></div></div>",
      "css": ".ds-dropzone{height:85px;border:1px dashed #ffffff26;border-radius:13px;display:flex;align-items:center;justify-content:center;gap:14px;font-family:Inter,\"Segoe UI\",sans-serif;color:var(--ink,#f5f5f7);transition:border .15s,background .15s}.ds-dropzone svg{width:26px;height:26px;color:#b1b1bb}.ds-dropzone strong{font-size:12px;display:block;font-weight:500}.ds-dropzone p{color:var(--muted,#a1a1a8);font-size:10px;margin:4px 0 0}.ds-dropzone.ds-dragging{border-color:var(--accent,#70d8ef);background:#70d8ef09}"
    }
  ],
  "narrative": {
    "northStar": "The Original Desktop Island",
    "overview": "The Original Desktop Island preserves the incumbent Boring Notch Octave demo: a compact black silhouette, photographic artwork, restrained sans lettering and a lower glass field. The Windows edition adapts the placement and supporting tools while keeping the original visual identity. This document records the finished Electron surface in `windows/electron/renderer/`; it does not replace the native macOS world or prescribe changes to its SwiftUI implementation.\n\nDensity serves an overlay used above ordinary desktop work. A quiet icon header leads into a single focused tool; music keeps the artwork beside metadata, lyrics, a fine timeline and transport. Floating, original-edge and corner placement support displays with or without a physical notch.\n\nThe user-requested Windows blue refinement gives interactive elements pale-blue primary actions, blue selected and hover surfaces, fine inset reflections and soft offset depth. This material belongs to controls; photographic artwork and playback retain the cover-derived accent within the original black island.",
    "keyCharacteristics": [
      "Compact black-to-glass island with an opaque fallback.",
      "Photographic artwork and authored SVG icons.",
      "Inter lettering, fine dividers and polished blue action controls.",
      "Shared artwork geometry, interruptible spring transitions and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Artwork Accent Rule",
        "body": "Use the cover-derived accent for the artist, playback progress and activity details; the default cyan remains the fallback. Keep the island and primary lettering neutral.",
        "section": "colors"
      },
      {
        "name": "The Control Blue Rule",
        "body": "Use Windows blue for button/input focus, primary actions and selected or hovered control surfaces. Preserve the artwork-derived playback accent and the amber stay-awake variant.",
        "section": "colors"
      },
      {
        "name": "The Small Control Rule",
        "body": "Keep routine controls at the implemented control and label sizes; reserve large numerals for time and usage totals.",
        "section": "typography"
      },
      {
        "name": "The Platform Material Rule",
        "body": "Use native Windows composition when available and retain the opaque island when glass is disabled or unavailable.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the original compact island identity and the music artwork/metadata relationship.",
      "Do use real artwork, SVG icons, thin timelines and bounded scrolling for longer lists.",
      "Do preserve floating and original-edge options for displays with and without a physical notch.",
      "Do maintain visible keyboard focus and honor both the system and in-app reduced-motion preference.",
      "Do keep native Windows availability and demonstration fixtures plainly labeled."
    ],
    "donts": [
      "Don't introduce a branded dashboard header or oversized text-button navigation into the music island.",
      "Don't mount separate artwork elements for open and closed states; the shared element carries the transition.",
      "Don't turn the transparent canvas outside the island into a visible panel or a click target.",
      "Don't treat still-image fidelity as evidence of smooth motion or verified Windows hardware behavior."
    ]
  }
}
